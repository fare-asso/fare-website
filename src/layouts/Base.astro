---
import { Font, getImage } from "astro:assets"
import logo from "@/assets/logo_fare.png"

import "@/styles/globals.css"

interface Props {
    title?: string
    description?: string
}

const {
    title = "FARE",
    description = "Fédération des Associations du Réseau Étudiant de Haute-Bretagne"
} = Astro.props

const favicon = await getImage({
    src: logo,
    format: "webp",
    width: 32,
    height: 32,
    quality: 100
})
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" href={favicon.src} type="image/webp">
        <title>{title}</title>
        <meta name="description" content={description}>
        <Font cssVariable="--font-ovo" preload />
        <Font cssVariable="--font-valley-sans" preload />
    </head>
    <body>
        <slot />
    </body>
</html>
