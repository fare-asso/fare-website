---
import ArticleCard from "@/components/public/articles/articleCard"
import prisma from "@/helpers/db"
import Public from "@/layouts/Public.astro"

const articles = await prisma.article.findMany({
    orderBy: {
        writtenOn: "desc"
    },
    take: 10
})

const filteredArticles = articles.filter((article) => article.published)
---

<Public
    title="Actualités"
    description="Page regroupant les actualités lié à la FARE"
>
    <div class="flex w-full flex-col items-center justify-start">
        <h1 class="py-12 text-3xl font-semibold md:py-32">Actualités</h1>
        <div class="flex h-full w-full flex-col items-center">
            <div
                class="flex w-full flex-col items-center space-y-4 md:w-3/4 lg:w-1/2"
            >
                {
                    filteredArticles.length === 0 ? (
                        <span class="text-xl text-gray-700">
                            Aucun article n'est disponible pour le moment...
                        </span>
                    ) : (
                        filteredArticles.map((article) => (
                            <ArticleCard article={article} />
                        ))
                    )
                }
            </div>
        </div>
    </div>
</Public>
