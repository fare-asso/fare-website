---
import CommuniquesCard from "@/components/public/presse/cdpCard"
import DossierDePresseCard from "@/components/public/presse/ddpCard"
import prisma from "@/helpers/db"
import Public from "@/layouts/Public.astro"

const communiques = await prisma.communiqueDePresse.findMany({
    orderBy: {
        createdAt: "desc"
    }
})
---

<Public title="Presse">
    <div
        class="mb-20 flex w-full flex-col items-center justify-start px-4 md:px-8 lg:px-16"
    >
        <h1 class="mt-6 mb-12 text-center text-3xl font-extrabold sm:text-4xl">
            Documents de{" "}
            <span class="highlight"> presse </span>
        </h1>

        <div class="flex w-3/4 flex-col items-center space-y-2">
            {communiques.length > 0 ? (
                    communiques.map((cdp) =>
                        cdp.type === "CDP" ? (
                            <CommuniquesCard communique={cdp} />
                        ) : (
                            <DossierDePresseCard dossier={cdp} />
                        )
                    )
                ) : (
                    <span class="text-xl">
                        Nous n'avons pas encore de documents de presse.🥲
                    </span>
                )}
        </div>
    </div>
</Public>
