---
import DossierDePresseCard from "@/components/public/presse/ddpCard"
import prisma from "@/helpers/db"
import Public from "@/layouts/Public.astro"

const dossiers = await prisma.communiqueDePresse.findMany({
    where: {
        type: "DDP"
    },
    orderBy: {
        createdAt: "desc"
    }
})
---

<Public title="Dossiers de presse">
    <div
        class="mb-20 flex w-full flex-col items-center justify-start px-4 md:px-8 lg:px-16"
    >
        <h1 class="mt-6 mb-12 text-center text-3xl font-extrabold sm:text-4xl">
            Dossiers de{" "}
            <span class="highlight"> presse </span>
        </h1>

        <div class="flex w-3/4 flex-col items-center space-y-2">
            {dossiers.length > 0 ? (
                    dossiers.map((dossier) => (
                        <DossierDePresseCard dossier={dossier} />
                    ))
                ) : (
                    <span class="text-xl">
                        Nous n'avons pas encore de dossiers de presse.
                    </span>
                )}
        </div>
    </div>
</Public>
