---
import {
    FiBookOpen,
    FiBox,
    FiCalendar,
    FiCheck,
    FiFlag,
    FiUserCheck,
    FiUsers
} from "react-icons/fi"

import { AdhesionForm } from "@/components/public/adhesion/adhesionForm"
import { buttonVariants } from "@/components/ui/button"
import Public from "@/layouts/Public.astro"
import { cn } from "@/lib/utils"

export const prerender = true
---

<Public title="Formulaire d'adhésion">
    <div class="flex w-full flex-col items-center justify-start">
        <div
            class="mt-6 mb-16 flex w-full max-w-3xl flex-col items-center text-center"
        >
            <h1 class="mb-4 text-3xl font-extrabold sm:text-4xl">
                Rejoindre le{" "}
                <span class="highlight"> réseau </span>
            </h1>
            <p class="mb-8 text-lg">
                La FARE est une organisation représentative asyndicale&nbsp;: on
                n'y adhère pas en tant qu'étudiant·e, mais en tant qu'<strong
                    >association étudiante</strong
                >, locale, de filière ou thématique, pour représenter ses
                étudiant·e·s et porter leurs projets.
            </p>
            <a
                href="#formulaire"
                class={cn(
                    buttonVariants({ size: "lg" }),
                    "bg-fare-accent hover:bg-fare-accent/90 text-white"
                )}
            >
                Remplir le formulaire d'adhésion
            </a>
            <p class="text-muted-foreground mt-4 text-sm">
                L'adhésion est ouverte à tout moment de l'année
            </p>
        </div>

        <section class="mb-16 w-full max-w-4xl">
            <h2 class="mb-8 text-center text-2xl font-bold">
                Pourquoi adhérer&nbsp;?
            </h2>
            <div class="grid grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-2">
                <div>
                    <h3 class="mb-1 flex items-center gap-2 font-semibold">
                        <FiUsers
                            className="text-fare-accent shrink-0"
                            size={18}
                        />
                        Un réseau fort et soudé
                    </h3>
                    <p class="text-muted-foreground text-sm">
                        Une vingtaine d'associations adhérentes, de Rennes à
                        Saint-Brieuc en passant par Saint-Malo ou Fougères. De
                        quoi créer des liens, échanger et s'entraider entre
                        associations du territoire.
                    </p>
                </div>
                <div>
                    <h3 class="mb-1 flex items-center gap-2 font-semibold">
                        <FiFlag
                            className="text-fare-accent shrink-0"
                            size={18}
                        />
                        Du poids dans les décisions
                    </h3>
                    <p class="text-muted-foreground text-sm">
                        La fédération porte la voix des étudiant·e·s auprès des
                        administrations universitaires, des collectivités et au
                        niveau national. Adhérer, c'est pouvoir y faire remonter
                        vos positions et administrer la FARE.
                    </p>
                </div>
                <div>
                    <h3 class="mb-1 flex items-center gap-2 font-semibold">
                        <FiUserCheck
                            className="text-fare-accent shrink-0"
                            size={18}
                        />
                        Un suivi personnalisé
                    </h3>
                    <p class="text-muted-foreground text-sm">
                        Chaque association adhérente se voit assigner un·e
                        membre du bureau fédéral&nbsp;: accompagnement des
                        projets, recherche de financements, soutien
                        administratif.
                    </p>
                </div>
                <div>
                    <h3 class="mb-1 flex items-center gap-2 font-semibold">
                        <FiBookOpen
                            className="text-fare-accent shrink-0"
                            size={18}
                        />
                        Des formations accessibles
                    </h3>
                    <p class="text-muted-foreground text-sm">
                        La FARE forme les associatif·ve·s, étudiant·e·s, élu·e·s
                        ou bénévoles qui en font la demande, sur des temps
                        personnalisés ou lors des événements de la fédération.
                    </p>
                </div>
                <div>
                    <h3 class="mb-1 flex items-center gap-2 font-semibold">
                        <FiBox
                            className="text-fare-accent shrink-0"
                            size={18}
                        />
                        Un accès facilité aux projets
                    </h3>
                    <p class="text-muted-foreground text-sm">
                        S'investir reste possible sans adhérer, que ce soit pour
                        emprunter du matériel{" "}
                        <a href="/projets/bagad-asso" class="link">
                            Bagad'Asso
                        </a>, devenir bénévole à l'<a
                            href="/projets/agorae"
                            class="link"
                            >AGORAé</a
                        >{" "}ou tuteur·ice avec{" "}
                        <a href="/projets/bouge-ta-prison" class="link">
                            Bouge Ta Prison
                        </a>.
                    </p>
                </div>
                <div>
                    <h3 class="mb-1 flex items-center gap-2 font-semibold">
                        <FiCalendar
                            className="text-fare-accent shrink-0"
                            size={18}
                        />
                        Des évènements à grande échelle
                    </h3>
                    <p class="text-muted-foreground text-sm">
                        Congrès, conférences, week-ends thématiques&nbsp;: des
                        temps forts organisés toute l'année sur le territoire de
                        Haute-Bretagne, auxquels la FARE vous intègre.
                    </p>
                </div>
            </div>
        </section>

        <section class="mb-12 w-full max-w-4xl">
            <h2 class="mb-4 text-center text-2xl font-bold">
                Comment adhérer&nbsp;?
            </h2>
            <p class="mx-auto mb-10 max-w-2xl text-center">
                Une seule condition&nbsp;: être{" "}
                <strong>
                    indépendante de tout parti politique, syndicat professionnel
                    ou confession
                </strong>{" "}
                regroupant des étudiant·e·s ou des jeunes.
            </p>
            <ol
                class="mb-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4"
            >
                <li class="flex flex-col items-center text-center">
                    <span
                        class="bg-fare-accent mb-3 flex h-10 w-10 items-center justify-center rounded-full text-lg font-bold text-white"
                    >
                        1
                    </span>
                    <h3 class="mb-2 font-semibold">Contactez le bureau</h3>
                    <p class="text-muted-foreground text-sm">
                        Un premier échange avec le bureau fédéral pour faire le
                        point sur votre situation.
                    </p>
                </li>
                <li class="flex flex-col items-center text-center">
                    <span
                        class="bg-fare-accent mb-3 flex h-10 w-10 items-center justify-center rounded-full text-lg font-bold text-white"
                    >
                        2
                    </span>
                    <h3 class="mb-2 font-semibold">Rassemblez les pièces</h3>
                    <p class="text-muted-foreground text-sm">
                        Les documents administratifs listés ci-dessous, à
                        joindre au formulaire.
                    </p>
                </li>
                <li class="flex flex-col items-center text-center">
                    <span
                        class="bg-fare-accent mb-3 flex h-10 w-10 items-center justify-center rounded-full text-lg font-bold text-white"
                    >
                        3
                    </span>
                    <h3 class="mb-2 font-semibold">Réglez la cotisation</h3>
                    <p class="text-muted-foreground text-sm">
                        À hauteur de la somme demandée pour le collège de votre
                        association.
                    </p>
                </li>
                <li class="flex flex-col items-center text-center">
                    <span
                        class="bg-fare-accent mb-3 flex h-10 w-10 items-center justify-center rounded-full text-lg font-bold text-white"
                    >
                        4
                    </span>
                    <h3 class="mb-2 font-semibold">Le CA vote</h3>
                    <p class="text-muted-foreground text-sm">
                        Après validation par le secrétariat général, l'adhésion
                        des associations néo-adhérentes est soumise au vote du
                        prochain Conseil d'Administration.
                    </p>
                </li>
            </ol>

            <div class="text-center">
                <h3 class="mb-4 text-xl font-semibold">Les pièces à fournir</h3>
                <ul class="inline-flex flex-col items-start gap-2 text-left">
                    <li class="flex items-center gap-2">
                        <FiCheck
                            className="text-fare-accent shrink-0"
                            size={20}
                        />
                        <span>
                            le récépissé de déclaration du bureau de
                            l'association en préfecture
                        </span>
                    </li>
                    <li class="flex items-center gap-2">
                        <FiCheck
                            className="text-fare-accent shrink-0"
                            size={20}
                        />
                        <span>
                            la liste des dirigeant·e·s en exercice et leurs
                            coordonnées
                        </span>
                    </li>
                    <li class="flex items-center gap-2">
                        <FiCheck
                            className="text-fare-accent shrink-0"
                            size={20}
                        />
                        <span>
                            l'extrait de procès-verbal de son instance qualifiée
                            autorisant l'association à adhérer à la FARE
                        </span>
                    </li>
                    <li class="flex items-center gap-2">
                        <FiCheck
                            className="text-fare-accent shrink-0"
                            size={20}
                        />
                        <span>
                            les statuts (et règlement intérieur si existant)
                        </span>
                    </li>
                    <li class="flex items-center gap-2">
                        <FiCheck
                            className="text-fare-accent shrink-0"
                            size={20}
                        />
                        <span>
                            la liste des élu·e·s étudiant·e·s soutenu·e·s et
                            revendiqué·e·s
                        </span>
                    </li>
                    <li class="flex items-center gap-2">
                        <FiCheck
                            className="text-fare-accent shrink-0"
                            size={20}
                        />
                        <span>le nombre d'étudiant·e·s adhérent·e·s</span>
                    </li>
                </ul>
            </div>
        </section>

        <aside
            class="border-fare-yellow mb-16 w-full max-w-2xl border-l-4 pl-4"
        >
            <p class="text-muted-foreground text-sm">
                Bon à savoir&nbsp;: l'adhésion peut être remplie à n'importe
                quel moment de l'année universitaire. Elle reste effective
                jusqu'à la prochaine campagne de ré-adhésion.
            </p>
        </aside>

        <section
            id="formulaire"
            class="flex w-full max-w-3xl scroll-mt-24 justify-center"
        >
            <AdhesionForm client:load />
        </section>
    </div>
</Public>
