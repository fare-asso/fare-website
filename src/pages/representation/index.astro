---
import { Image } from "astro:assets"

import logoBTC from "@/assets/elues/logo-Bouge-Ton-Crous.png"
import logoCrous from "@/assets/Logo_Crous_vectorisé.png"
import logoFage from "@/assets/Logo_FAGE.png"
import logoUR2 from "@/assets/univ/Logo_univ-rennes2-2016.png"
import logoUR from "@/assets/univ/UNIRENNES_LOGOnoir_centre_RVB.png"
import Public from "@/layouts/Public.astro"
---

<Public title="Représentation">
    <div
        class="flex w-full flex-col items-center justify-start px-4 md:px-8 lg:px-16"
    >
        <h1 class="py-10 text-center text-4xl font-bold sm:py-16">
            Représentations
        </h1>
        <div
            class="flex w-full max-w-5xl flex-col items-center justify-center gap-12 md:flex-row md:gap-20"
        >
            <a
                href="/representation/fage"
                class="flex h-64 w-full max-w-sm min-w-64 flex-row items-center justify-center gap-4 rounded-2xl border-1 border-neutral-800/30 p-6 transition-all hover:bg-black/[0.04] md:h-72"
            >
                <span class="text-3xl font-bold md:text-4xl">LA</span>
                <Image
                    src={logoFage}
                    alt="Logo de la FAGE"
                    class="h-24 w-auto object-contain md:h-32"
                />
            </a>

            <a
                href="/representation/nos-elues"
                class="flex h-64 w-full max-w-sm min-w-64 flex-col items-center justify-center gap-4 rounded-2xl border-1 border-neutral-800/30 p-6 transition-all hover:bg-black/[0.04] md:h-72"
            >
                <div class="flex flex-wrap items-center justify-center gap-3">
                    <Image
                        src={logoBTC}
                        alt="Logo Bouge Ton Crous"
                        class="h-16 w-16 object-contain"
                    />
                    <Image
                        src={logoCrous}
                        alt="Logo les Crous"
                        class="h-16 w-16 object-contain"
                    />
                    <Image
                        src={logoUR}
                        alt="Logo Université de Rennes"
                        class="h-16 w-16 object-contain"
                    />
                    <Image
                        src={logoUR2}
                        alt="Logo Université Rennes 2"
                        class="h-16 w-16 object-contain"
                    />
                </div>
                <span class="text-3xl font-bold md:text-4xl">Nos éluEs</span>
            </a>
        </div>
    </div>
</Public>
