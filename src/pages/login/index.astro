---
import { Image } from "astro:assets"
import { isDevelopment } from "std-env"

import logo from "@/assets/logo_fare.png"
import Base from "@/layouts/Base.astro"

const error = Astro.url.searchParams.get("error")
---

<Base
    title="Connexion"
    description="Page de connexion pour les administrateur·ice·s"
>
    <main class="grid min-h-screen place-items-center items-center p-2">
        <div
            class="bg-card text-card-foreground mx-auto flex max-w-full min-w-1/3 flex-col gap-6 rounded-xl border py-6 shadow-sm"
        >
            <div class="flex flex-col items-start gap-1.5 px-6">
                <Image
                    src={logo}
                    alt="Logo de la FARE"
                    class="mx-auto mb-6 w-1/5 text-center"
                />
                <div
                    class="flex items-center gap-1 leading-none font-semibold"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="22"
                        height="22"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path
                            d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"
                        ></path><circle cx="12" cy="11" r="4"></circle><path
                            d="M12 9v2l1 1"></path></svg
                    >
                    <span>Connexion Admin</span>
                </div>
                <p class="text-muted-foreground text-sm">
                    Accès réservé au bureau de la fédération
                </p>
                {
                    error && (
                        <div class="mt-4 rounded border border-red-500 bg-red-50 p-2 text-red-600">
                            Une erreur s'est produite lors de la connexion.
                            Merci de réessayer plus tard.
                        </div>
                    )
                }
            </div>
            <div class="px-6">
                <a
                    href="/login/google"
                    class="border-input bg-background hover:bg-accent hover:text-accent-foreground flex h-12 w-full max-w-full items-center justify-center gap-2 rounded-md border text-sm font-medium shadow-xs transition-all"
                >
                    <svg width="18" height="18" viewBox="0 0 48 48"
                        ><path
                            fill="#FFC107"
                            d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"
                        ></path><path
                            fill="#FF3D00"
                            d="m6.306 14.691 6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"
                        ></path><path
                            fill="#4CAF50"
                            d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.91 11.91 0 0 1 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"
                        ></path><path
                            fill="#1976D2"
                            d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"
                        ></path></svg
                    >
                    Continuer avec Google
                </a>
                <div
                    class="mt-2 text-center text-xs text-balance text-gray-500"
                >
                    Utilisez votre adresse Google FARE (qui termine par
                    @fare-asso.fr)
                </div>

                {
                    isDevelopment && (
                        <>
                            <div class="flex w-full items-center justify-center py-6">
                                <div class="flex-1 border-t border-gray-300" />
                                <span class="px-4 text-sm text-gray-500">
                                    ou
                                </span>
                                <div class="flex-1 border-t border-gray-300" />
                            </div>

                            <form
                                method="post"
                                action="/login/password"
                                class="space-y-3"
                            >
                                <label
                                    class="text-sm font-medium"
                                    for="email"
                                >
                                    Email
                                </label>
                                <input
                                    class="border-input flex h-9 w-full rounded-md border bg-transparent px-3 py-1 text-sm shadow-xs"
                                    type="email"
                                    name="email"
                                    id="email"
                                />
                                <label
                                    class="text-sm font-medium"
                                    for="password"
                                >
                                    Mot de passe
                                </label>
                                <input
                                    class="border-input flex h-9 w-full rounded-md border bg-transparent px-3 py-1 text-sm shadow-xs"
                                    type="password"
                                    name="password"
                                    id="password"
                                />
                                <button
                                    type="submit"
                                    class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-9 w-full items-center justify-center rounded-md text-sm font-medium shadow-xs transition-all"
                                >
                                    Se connecter
                                </button>
                            </form>
                        </>
                    )
                }
            </div>
        </div>
    </main>
</Base>
