---
import { fetchInstances } from "@/actions/instances/listInstancesAction"
import InstancesPage from "@/components/dashboard/elus/instancesPage"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
if (!hasPermission(user, "access:instances")) {
    return Astro.redirect("/dashboard/unauthorized")
}
const instances = (await fetchInstances()) ?? []
---

<Dashboard title="Instances">
    <InstancesPage
        client:load
        initialInstances={instances}
        canCreate={hasPermission(user, "create:instance")}
        canEdit={hasPermission(user, "edit:instance")}
        canDelete={hasPermission(user, "delete:instance")}
    />
</Dashboard>
