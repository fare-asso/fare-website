---
import { fetchCDP } from "@/actions/CDP/listCDPAction"
import CDPPage from "@/components/dashboard/CDP/cdpPage"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
const communiques = (await fetchCDP()) ?? []
---

<Dashboard title="Communiques de presse">
    <CDPPage
        client:load
        initialData={communiques}
        canCreate={hasPermission(user, "create:cdp")}
        canDelete={hasPermission(user, "delete:cdp")}
    />
</Dashboard>
