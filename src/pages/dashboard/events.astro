---
import { fetchEvents } from "@/actions/events/listEventsAction"
import EventsPage from "@/components/dashboard/event/eventsPage"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
const events = (await fetchEvents()) ?? []
---

<Dashboard title="Évènements">
    <EventsPage
        client:load
        initialData={events}
        canCreate={hasPermission(user, "create:event")}
        canEdit={hasPermission(user, "edit:event")}
        canDelete={hasPermission(user, "delete:event")}
    />
</Dashboard>
