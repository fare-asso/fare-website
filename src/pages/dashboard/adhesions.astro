---
import { fetchAdhesions } from "@/actions/adhesion/listAdhesionsAction"
import AdhesionsPage from "@/components/dashboard/adhesions/adhesionsPage"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
if (!hasPermission(user, "access:adhesions")) {
    return Astro.redirect("/dashboard/unauthorized")
}
const adhesions = (await fetchAdhesions()) ?? []
---

<Dashboard title="Adhésions">
    <AdhesionsPage
        client:load
        initialData={adhesions}
        canEdit={hasPermission(user, "edit:adhesion")}
        canDownload={hasPermission(user, "download:adhesion-folder")}
    />
</Dashboard>
