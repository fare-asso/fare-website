---
import { fetchArticles } from "@/actions/articles/listArticlesAction"
import ArticlesPage from "@/components/dashboard/articles/articlesPage"
import { toShellUser } from "@/components/dashboard/shell"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
const articles = (await fetchArticles()) ?? []
---

<Dashboard title="Articles">
    <ArticlesPage
        client:load
        user={toShellUser(user)}
        pathname={Astro.url.pathname}
        initialData={articles}
        canCreate={hasPermission(user, "create:article")}
        canEdit={hasPermission(user, "edit:article")}
        canDelete={hasPermission(user, "delete:article")}
        canPublish={hasPermission(user, "publish:article")}
    />
</Dashboard>
