---
import DefenseDroitsPage from "@/components/dashboard/defenseDesDroits/defenseDroitsPage"
import { toShellUser } from "@/components/dashboard/shell"
import { getAssistanceConfig } from "@/helpers/assistanceConfig"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
if (!hasPermission(user, "access:defense-droits")) {
    return Astro.redirect("/dashboard/unauthorized")
}
const config = await getAssistanceConfig()
---

<Dashboard title="Défense des droits">
    <DefenseDroitsPage
        client:load
        user={toShellUser(user)}
        pathname={Astro.url.pathname}
        recipientEmail={config.recipientEmail}
        delay={config.delay}
    />
</Dashboard>
