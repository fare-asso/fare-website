---
import UserDetailPage from "@/components/dashboard/users/userDetailPage"
import prisma from "@/helpers/db"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
const id = Astro.params.id!

const targetUser = await prisma.user.findUnique({
    where: { id },
    include: {
        permissions: {
            include: {
                permission: true
            }
        }
    }
})

if (!targetUser) {
    return Astro.rewrite("/404")
}

const allPermissions = await prisma.permission.findMany()
---

<Dashboard title={`Utilisateur ${id}`}>
    <UserDetailPage
        client:load
        targetUser={targetUser}
        userPermissionIds={targetUser.permissions.map((p) => p.permission.id)}
        allPermissions={allPermissions}
        canEdit={hasPermission(user, "edit:user")}
        canDelete={hasPermission(user, "delete:user")}
        canEditPermissions={hasPermission(user, "edit:user-permissions")}
    />
</Dashboard>
