---
import { fetchAssociations } from "@/actions/associations/listAssociationsAction"
import AssociationsPage from "@/components/dashboard/associations/associationsPage"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
const associations = (await fetchAssociations()) ?? []
---

<Dashboard title="Associations">
    <AssociationsPage
        client:load
        initialData={associations}
        canCreate={hasPermission(user, "create:association")}
        canEdit={hasPermission(user, "edit:association")}
        canDelete={hasPermission(user, "delete:association")}
        canApprove={hasPermission(user, "approve:association")}
    />
</Dashboard>
