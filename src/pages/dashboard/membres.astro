---
import { fetchMembersWithPictures } from "@/actions/members/listMembersAction"
import MembersPage from "@/components/dashboard/members/membersPage"
import { toShellUser } from "@/components/dashboard/shell"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
const members = (await fetchMembersWithPictures()) ?? []
---

<Dashboard title="Membres">
    <MembersPage
        client:load
        user={toShellUser(user)}
        pathname={Astro.url.pathname}
        initialMembers={members}
        canCreate={hasPermission(user, "create:member")}
        canEdit={hasPermission(user, "edit:member")}
        canDelete={hasPermission(user, "delete:member")}
    />
</Dashboard>
