---
import { fetchEquipments } from "@/actions/bagadAsso/listEquipmentsAction"
import EquipmentsPage from "@/components/dashboard/bagadAsso/equipmentsPage"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
const equipments = (await fetchEquipments()) ?? []
---

<Dashboard title="Bagad'Asso — Matériel">
    <EquipmentsPage
        client:load
        initialEquipments={equipments}
        canCreate={hasPermission(user, "create:bagad-equipment")}
        canEdit={hasPermission(user, "edit:bagad-equipment")}
        canDelete={hasPermission(user, "delete:bagad-equipment")}
    />
</Dashboard>
