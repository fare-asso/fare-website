---
import { fetchTickets } from "@/actions/bagadAsso/listTicketsAction"
import TicketsPage from "@/components/dashboard/bagadAsso/ticketsPage"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
const tickets = (await fetchTickets()) ?? []
---

<Dashboard title="Bagad'Asso — Tickets">
    <TicketsPage
        client:load
        initialTickets={tickets}
        canManage={hasPermission(user, "access:bagad-asso")}
        calendarToken={user.calendarToken}
    />
</Dashboard>
