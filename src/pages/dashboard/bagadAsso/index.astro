---
import { fetchBagadCalendar } from "@/actions/bagadAsso/listCalendarAction"
import CalendarPage from "@/components/dashboard/bagadAsso/calendarPage"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
if (!hasPermission(user, "access:bagad-asso")) {
    return Astro.redirect("/dashboard/unauthorized")
}
const tickets = (await fetchBagadCalendar()) ?? []
---

<Dashboard title="Bagad'Asso">
    <CalendarPage
        client:load
        initialTickets={tickets}
        initialSearch={Astro.url.search}
    />
</Dashboard>
