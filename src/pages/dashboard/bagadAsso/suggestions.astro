---
import { fetchSuggestions } from "@/actions/bagadAsso/listSuggestionsAction"
import SuggestionsPage from "@/components/dashboard/bagadAsso/suggestionsPage"
import { toShellUser } from "@/components/dashboard/shell"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
const suggestions = (await fetchSuggestions()) ?? []
---

<Dashboard title="Bagad'Asso — Suggestions">
    <SuggestionsPage
        client:load
        user={toShellUser(user)}
        pathname={Astro.url.pathname}
        initialSuggestions={suggestions}
    />
</Dashboard>
