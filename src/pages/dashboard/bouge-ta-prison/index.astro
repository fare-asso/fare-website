---
import { fetchTutorApplications } from "@/actions/bouge-ta-prison/listTutorApplicationsAction"
import CandidaturesPage from "@/components/dashboard/bougeTaPrison/candidaturesPage"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
if (!hasPermission(user, "access:btp")) {
    return Astro.redirect("/dashboard/unauthorized")
}
const applications = (await fetchTutorApplications()) ?? []
---

<Dashboard title="Bouge Ta Prison">
    <CandidaturesPage client:load initialData={applications} />
</Dashboard>
