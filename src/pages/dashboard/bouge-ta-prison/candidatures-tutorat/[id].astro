---
import CandidatureDetailPage from "@/components/dashboard/bougeTaPrison/candidatureDetailPage"
import { toShellUser } from "@/components/dashboard/shell"
import prisma from "@/helpers/db"
import { hasPermission } from "@/helpers/permissions"
import { createClient } from "@/helpers/supabase/astro"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
if (!hasPermission(user, "access:btp")) {
    return Astro.redirect("/dashboard/unauthorized")
}

const id = Astro.params.id!
if (Number.isNaN(Number(id))) {
    return Astro.rewrite("/404")
}

const application = await prisma.bTPTutorApplication.findUnique({
    where: { id: Number(id) }
})
if (!application) {
    return Astro.rewrite("/404")
}

const supabase = createClient(Astro)
const { data: cvSignedUrlData } = await supabase.storage
    .from("btp-tutor-application")
    .createSignedUrl(application.cvPath, 3600)
const { data: lmSignedUrlData } = await supabase.storage
    .from("btp-tutor-application")
    .createSignedUrl(application.mlPath, 3600)
---

<Dashboard title={`Candidature ${application.id}`}>
    <CandidatureDetailPage
        client:load
        user={toShellUser(user)}
        pathname={Astro.url.pathname}
        application={application}
        cvUrl={cvSignedUrlData?.signedUrl ?? null}
        lmUrl={lmSignedUrlData?.signedUrl ?? null}
    />
</Dashboard>
