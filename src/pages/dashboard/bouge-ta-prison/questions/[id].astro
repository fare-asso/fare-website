---
import QuestionDetailPage from "@/components/dashboard/bougeTaPrison/questionDetailPage"
import prisma from "@/helpers/db"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
if (!hasPermission(user, "access:btp")) {
    return Astro.redirect("/dashboard/unauthorized")
}

const id = Astro.params.id!
if (Number.isNaN(Number(id))) {
    return Astro.rewrite("/404")
}

const question = await prisma.bTPTutorQuestion.findUnique({
    where: { id: Number(id) }
})
if (!question) {
    return Astro.rewrite("/404")
}
---

<Dashboard title={`Question ${question.id}`}>
    <QuestionDetailPage client:load question={question} />
</Dashboard>
