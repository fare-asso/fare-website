---
import { fetchTutorQuestions } from "@/actions/bouge-ta-prison/listTutorQuestionsAction"
import QuestionsPage from "@/components/dashboard/bougeTaPrison/questionsPage"
import { toShellUser } from "@/components/dashboard/shell"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
if (!hasPermission(user, "access:btp")) {
    return Astro.redirect("/dashboard/unauthorized")
}
const questions = (await fetchTutorQuestions()) ?? []
---

<Dashboard title="Bouge Ta Prison — Questions">
    <QuestionsPage
        client:load
        user={toShellUser(user)}
        pathname={Astro.url.pathname}
        initialData={questions}
    />
</Dashboard>
