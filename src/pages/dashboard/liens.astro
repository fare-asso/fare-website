---
import { fetchLinks } from "@/actions/links/listLinksAction"
import LinksPage from "@/components/dashboard/links/linksPage"
import { hasPermission } from "@/helpers/permissions"
import Dashboard from "@/layouts/Dashboard.astro"

const user = Astro.locals.user!
if (!hasPermission(user, "access:liens")) {
    return Astro.redirect("/dashboard/unauthorized")
}
const data = (await fetchLinks()) ?? { categories: [], files: {} }
---

<Dashboard title="Liens">
    <LinksPage
        client:load
        initialData={data}
        canCreate={hasPermission(user, "create:lien")}
        canEdit={hasPermission(user, "edit:lien")}
        canDelete={hasPermission(user, "delete:lien")}
    />
</Dashboard>
