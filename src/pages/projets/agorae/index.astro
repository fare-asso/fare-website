---
import { Image } from "astro:assets"
import { FaInstagram, FaRegFilePdf } from "react-icons/fa6"
import { FiDownload, FiExternalLink } from "react-icons/fi"

import food from "@/assets/AGORAe/food.jpg"
import logoAgoraE from "@/assets/AGORAe/logo_AgoraE.png"
import salle from "@/assets/AGORAe/salle.jpg"
import logoUR2 from "@/assets/univ/Logo_univ-rennes2-2016.png"
import logoUR from "@/assets/univ/UNIRENNES_LOGOnoir_centre_RVB.png"
import CalculateurBeneficiaire from "@/components/public/agorae/calculateurBeneficiaire"
import { buttonVariants } from "@/components/ui/button"
import Public from "@/layouts/Public.astro"
import { cn } from "@/lib/utils"

const rapportActiviteUrl = "/documents/Rapport_activite_AGORAe_2025-2026.pdf"

export const prerender = true
---

<Public title="AGORAé">
    <div class="flex w-full flex-col items-center justify-start">
        <Image
            src={logoAgoraE}
            alt="Logo de l'AGORAé"
            class="mb-10 w-full max-w-sm"
            priority
            height={750}
        />

        <div
            class="mb-16 flex w-full max-w-3xl flex-col items-center text-center"
        >
            <h1 class="mb-4 text-3xl font-extrabold sm:text-4xl">
                L'épicerie{" "}
                <span class="highlight before:bg-agorae/30"> solidaire </span>
                {" "}
                des étudiant·e·s de Saint-Brieuc
            </h1>
            <p class="mb-8 text-lg">
                Des produits alimentaires, d'hygiène et d'entretien à{" "}
                <strong>10% de leur valeur en grande surface</strong>, ou
                distribués <strong>gratuitement</strong>. Une épicerie créée par
                les étudiant·e·s et pour les étudiant·e·s, au Ty-Maz' sur le
                campus Mazier.
            </p>
            <a
                href="#beneficiaire"
                class={cn(
                    buttonVariants({ size: "lg" }),
                    "bg-agorae-deep hover:bg-agorae-deep/90 text-white"
                )}
            >
                Devenir bénéficiaire
            </a>
            <p class="text-muted-foreground mt-4 text-sm">
                Suis-nous sur Instagram&nbsp;:{" "}
                <a
                    href="https://www.instagram.com/agorae.saint.brieuc"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link"
                >
                    @agorae.saint.brieuc
                </a>
            </p>
        </div>

        <section
            class="mb-12 grid w-full max-w-4xl grid-cols-1 items-center gap-6 md:grid-cols-2 md:gap-10"
        >
            <Image
                src={food}
                alt="Nourriture proposée à l'AGORAé"
                class="w-full rounded-2xl object-cover"
                width={600}
            />
            <div>
                <h2>Une épicerie accessible sur critères sociaux</h2>
                <p>
                    L'objectif&nbsp;: permettre aux étudiant·e·s en situation de
                    précarité financière de réduire leurs dépenses quotidiennes.
                    L'accès à l'épicerie et le montant du panier mensuel
                    dépendent du Reste à Vivre de chacun·e.
                </p>
            </div>
        </section>

        <section
            class="mb-12 grid w-full max-w-4xl grid-cols-1 items-center gap-6 md:grid-cols-2 md:gap-10"
        >
            <Image
                src={salle}
                alt="Cantine de l'AGORAé"
                class="w-full rounded-2xl object-cover md:order-2"
                width={600}
            />
            <div>
                <h2>Un espace de convivialité</h2>
                <p>
                    Le Ty-Maz', qui accueille l'épicerie, est un lieu de vie
                    ouvert à tous·tes&nbsp;: on s'y retrouve pour se rencontrer,
                    échanger, et participer aux actions organisées contre
                    l'isolement social des étudiant·e·s du territoire.
                </p>
            </div>
        </section>

        <p class="text-muted-foreground mb-16 w-full max-w-2xl text-center">
            L'AGORAé est un projet national créé par la{" "}
            <a href="/representation/fage" class="link">FAGE</a>
            {" "}et porté à Saint-Brieuc par la{" "}
            <a href="/a-propos" class="link">FARE</a>&nbsp;: des lieux
            non-stigmatisants, gérés par des jeunes pour des jeunes, qui œuvrent
            pour l'égalité des chances dans l'enseignement supérieur.
        </p>

        <section id="beneficiaire" class="mb-16 w-full max-w-4xl scroll-mt-24">
            <h2 class="mb-8 text-center text-2xl font-bold">
                Comment devenir bénéficiaire&nbsp;?
            </h2>
            <ol class="mb-14 grid grid-cols-1 gap-8 md:grid-cols-3">
                <li class="flex flex-col items-center text-center">
                    <span
                        class="bg-agorae-deep mb-3 flex h-10 w-10 items-center justify-center rounded-full text-lg font-bold text-white"
                    >
                        1
                    </span>
                    <h3 class="mb-2 font-semibold">
                        Calcule ton Reste à Vivre
                    </h3>
                    <p class="text-muted-foreground text-sm">
                        Avec le calculateur ci-dessous, estime en quelques
                        secondes le panier auquel tu as droit.
                    </p>
                </li>
                <li class="flex flex-col items-center text-center">
                    <span
                        class="bg-agorae-deep mb-3 flex h-10 w-10 items-center justify-center rounded-full text-lg font-bold text-white"
                    >
                        2
                    </span>
                    <h3 class="mb-2 font-semibold">Inscris-toi en ligne</h3>
                    <p class="text-muted-foreground text-sm">
                        Sur{" "}
                        <a
                            href="https://mon-compte.fage.org/creation-compte"
                            title="Inscription AGORAé"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="link"
                        >
                            mon-compte.fage.org
                        </a>, la démarche ne prend que quelques minutes.
                    </p>
                </li>
                <li class="flex flex-col items-center text-center">
                    <span
                        class="bg-agorae-deep mb-3 flex h-10 w-10 items-center justify-center rounded-full text-lg font-bold text-white"
                    >
                        3
                    </span>
                    <h3 class="mb-2 font-semibold">Viens faire tes courses</h3>
                    <p class="text-muted-foreground text-sm">
                        Au Ty-Maz' sur le campus Mazier, pendant les permanences
                        de l'épicerie.
                    </p>
                </li>
            </ol>

            <h3 class="mb-4 text-center text-xl font-semibold">
                Le Reste à Vivre (RAV), c'est quoi&nbsp;?
            </h3>
            <p class="mb-8 text-center">
                C'est la somme qu'il te reste chaque jour pour te nourrir, une
                fois les charges courantes payées&nbsp;:
            </p>

            <div class="mb-14 flex flex-col items-center gap-3">
                <div
                    class="flex flex-wrap items-center justify-center gap-2 font-semibold"
                >
                    <span class="text-2xl">(</span>
                    <span
                        class="bg-agorae-deep rounded-lg px-3 py-2 text-white"
                    >
                        Recettes par mois
                    </span>
                    <span class="text-xl">−</span>
                    <span
                        class="bg-agorae-deep rounded-lg px-3 py-2 text-white"
                    >
                        Dépenses par mois
                    </span>
                    <span class="text-2xl">)</span>
                </div>
                <div class="border-foreground w-full max-w-md border-t-2"></div>
                <p class="font-semibold">30 jours</p>
                <p class="text-agorae-deep font-bold">= ton RAV quotidien</p>
            </div>

            <p class="mb-6 text-center">
                Ce RAV détermine ensuite le panier mensuel proposé à chaque
                étudiant·e&nbsp;:
            </p>

            <div
                class="mx-auto mb-14 w-full max-w-2xl overflow-x-auto rounded-xl"
            >
                <table class="w-full text-center text-sm sm:text-base">
                    <thead class="bg-agorae-deep text-white">
                        <tr>
                            <th class="px-4 py-3 font-semibold">
                                RAV quotidien
                            </th>
                            <th class="px-4 py-3 font-semibold">
                                Denrées en valeur marchande
                            </th>
                            <th class="px-4 py-3 font-semibold">
                                Prix payé à l'AGORAé
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-border divide-y">
                        <tr>
                            <td class="px-4 py-3 font-medium">
                                Moins de 0,70€
                            </td>
                            <td class="px-4 py-3">Selon le besoin</td>
                            <td class="px-4 py-3 font-semibold">0€</td>
                        </tr>
                        <tr class="bg-agorae/5">
                            <td class="px-4 py-3 font-medium">
                                Entre 0,70€ et 7,50€
                            </td>
                            <td class="px-4 py-3">Jusqu'à 240€</td>
                            <td class="px-4 py-3 font-semibold">Jusqu'à 24€</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 font-medium">Plus de 7,50€</td>
                            <td class="px-4 py-3">10€</td>
                            <td class="px-4 py-3 font-semibold">1€</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="mb-10">
                <CalculateurBeneficiaire client:visible />
            </div>

            <p class="text-muted-foreground text-center text-balance text-sm">
                En difficulté pour compléter la démarche d'inscription&nbsp;?
                Écris-nous à{" "}
                <a href="mailto:agorae@fare-asso.fr" class="link text-nowrap">
                    agorae@fare-asso.fr
                </a>
                {" "}ou viens nous rencontrer pendant les permanences de
                l'épicerie.
            </p>
        </section>

        <section
            id="benevolat"
            class="mb-16 grid w-full max-w-4xl scroll-mt-24 grid-cols-1 gap-10 md:grid-cols-2"
        >
            <div class="flex flex-col items-center text-center">
                <h2 class="mb-2 text-xl font-bold">
                    Envie de participer&nbsp;?
                </h2>
                <p class="text-muted-foreground mb-4 text-sm">
                    Quelques heures ou quelques jours de disponibles&nbsp;?
                    Accueil, gestion des stocks, communication&nbsp;: tout
                    engagement est le bienvenu.
                </p>
                <a
                    href="https://forms.gle/DHoMDL7N3QRHTL1w7"
                    target="_blank"
                    rel="noopener noreferrer"
                    class={cn(buttonVariants(), "mt-auto")}
                >
                    Devenir bénévole
                </a>
            </div>
            <div class="flex flex-col items-center text-center">
                <h2 class="mb-2 text-xl font-bold">Quand venir&nbsp;?</h2>
                <p class="text-muted-foreground mb-4 text-sm">
                    Les horaires d'ouverture sont publiés sur Instagram. Un
                    imprévu&nbsp;? Contacte-nous à{" "}
                    <a href="mailto:agorae@fare-asso.fr" class="link">
                        agorae@fare-asso.fr
                    </a>.
                </p>
                <a
                    href="https://www.instagram.com/agorae.saint.brieuc"
                    target="_blank"
                    rel="noopener noreferrer"
                    class={cn(
                        buttonVariants({ variant: "outline" }),
                        "mt-auto gap-2"
                    )}
                >
                    <FaInstagram size={18} />
                    @agorae.saint.brieuc
                </a>
            </div>
        </section>

        <section class="w-full max-w-4xl">
            <h2 class="mb-6 text-center text-2xl font-bold">Documentation</h2>

            <div
                class="group border-border bg-card flex w-full flex-col gap-4 rounded-2xl border-2 p-4 transition-shadow hover:shadow-md sm:flex-row sm:items-center"
            >
                <div
                    class="flex h-14 w-14 shrink-0 items-center justify-center self-center rounded-lg bg-red-50 transition-colors group-hover:bg-red-100"
                >
                    <FaRegFilePdf size={28} className="text-red-500" />
                </div>
                <div
                    class="flex min-w-0 flex-1 flex-col gap-1 text-center sm:text-left"
                >
                    <a
                        href={rapportActiviteUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-foreground hover:text-agorae-deep truncate font-medium transition-colors hover:underline"
                    >
                        Rapport d'activité AGORAé 2025-2026
                    </a>
                </div>
                <div
                    class="flex shrink-0 items-center justify-center gap-2 sm:justify-end"
                >
                    <a
                        href={rapportActiviteUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="bg-background text-muted-foreground hover:bg-accent hover:text-accent-foreground inline-flex h-9 items-center gap-2 rounded-md border px-3 text-sm shadow-xs transition-colors"
                    >
                        <FiExternalLink size={16} />
                        <span class="sr-only md:not-sr-only">Consulter</span>
                    </a>
                    <a
                        href={rapportActiviteUrl}
                        download="Rapport_activite_AGORAe_2025-2026.pdf"
                        class="bg-agorae-deep hover:bg-agorae-deep/90 inline-flex h-9 items-center gap-2 rounded-md px-3 text-sm text-white shadow-xs transition-colors"
                    >
                        <FiDownload size={16} />
                        <span class="sr-only md:not-sr-only">Télécharger</span>
                    </a>
                </div>
            </div>

            <p class="mt-6 text-center text-sm">
                Retrouvez aussi l'AGORAé Saint-Brieuc sur{" "}
                <a
                    href="https://soliguide.fr/fr/fiche/agorae-saint-brieuc-37414"
                    title="Lien vers soliguide"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link"
                >
                    Soliguide
                </a>.
            </p>
        </section>

        <section class="mt-16 w-full max-w-3xl text-center">
            <p class="text-muted-foreground mb-6 text-sm">
                Un projet financé par&nbsp;:
            </p>
            <div
                class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6"
            >
                <Image
                    src={logoUR}
                    alt="Logo de l'Université de Rennes"
                    class="h-16 w-auto object-contain"
                    width={175}
                />
                <Image
                    src={logoUR2}
                    alt="Logo de l'Université Rennes 2"
                    class="h-16 w-auto object-contain"
                    width={175}
                />
            </div>
        </section>
    </div>
</Public>
