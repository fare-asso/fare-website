---
import { Image } from "astro:assets"

import assemblee0 from "@/assets/BTP/assemblee1.jpg"
import assemblee1 from "@/assets/BTP/assemblee2.jpg"
import logoBTP from "@/assets/BTP/Logo_BTP.png"
import { buttonVariants } from "@/components/ui/button"
import Public from "@/layouts/Public.astro"
import { cn } from "@/lib/utils"

export const prerender = true
---

<Public title="Bouge ta Prison">
    <div class="flex w-full flex-col items-center justify-start">
        <Image
            src={logoBTP}
            alt="Logo du projet Bouge Ta Prison"
            class="mb-10 w-72"
            priority
        />

        <div
            class="mb-16 flex w-full max-w-3xl flex-col items-center text-center"
        >
            <h1 class="mb-4 text-3xl font-extrabold sm:text-4xl">
                Sensibiliser,{" "}
                <span class="bg-btp-gold/40 highlight">accompagner</span>,
                réinsérer
            </h1>
            <p class="mb-8 text-lg">
                Bouge Ta Prison sensibilise les étudiant·e·s au monde carcéral
                et favorise la réinsertion des personnes placées sous main de
                justice&nbsp;: conférences, accompagnement sur les campus et
                tutorat en détention.
            </p>
            <a
                href="/projets/bouge-ta-prison/tutorat"
                class={cn(
                    buttonVariants({ size: "lg" }),
                    "bg-btp-blue hover:bg-btp-blue/90 text-white"
                )}
            >
                Devenir tuteur·ice
            </a>
        </div>

        <section class="mb-16 w-full max-w-4xl">
            <h2>Sensibiliser au milieu carcéral</h2>
            <p class="mb-6">
                Le pôle organise des conférences, comme en février 2024 à
                l'Université Rennes 2, où deux visiteurs de prison sont venus
                témoigner de leur expérience. Au sein du{" "}
                <a
                    href="https://collectifprisonrennes.fr/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link"
                >
                    Collectif Prison Rennes
                </a>, la FARE participe aussi chaque novembre aux{" "}
                <strong>Journées Nationales des Prisons (JNP)</strong>
                {" "}pour les faire connaître auprès des étudiant·e·s.
            </p>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <Image
                    src={assemblee0}
                    alt="Photo d'une conférence de sensibilisation du milieu carcéral à l'Université de Rennes 2 qui s'est déroulée en février 2024"
                    class="w-full rounded-2xl object-cover"
                />
                <Image
                    src={assemblee1}
                    alt="Deuxième photo de la conférence de sensibilisation du milieu carcéral à l'Université de Rennes 2"
                    class="w-full rounded-2xl object-cover"
                />
            </div>
        </section>

        <section class="mb-16 w-full max-w-4xl">
            <h2>Accompagner la réinsertion</h2>
            <p class="mb-4">
                Lors de permissions de sortie, le projet accompagne des
                personnes placées sous main de justice sur les campus
                universitaires&nbsp;: visite du campus, fonctionnement
                administratif, emprunt de livres dans les bibliothèques
                universitaires…
            </p>
            <p class="mb-10">
                En collaboration avec l'Université Rennes 2 et l'Administration
                pénitentiaire, la FARE organise aussi du tutorat pour les
                étudiant·e·s détenu·e·s en reprise d'études universitaires. Le
                projet assure le recrutement des tuteur·rice·s, une partie de
                leur formation et le suivi du tutorat toute l'année scolaire.
                L'année dernière&nbsp;:
            </p>
            <div
                class="mb-10 grid grid-cols-1 gap-8 text-center sm:grid-cols-3"
            >
                <div>
                    <p class="text-btp-blue text-4xl font-extrabold">24</p>
                    <p class="text-muted-foreground text-sm">
                        tuteur·rice·s intervenu·e·s en binôme
                    </p>
                </div>
                <div>
                    <p class="text-btp-blue text-4xl font-extrabold">12</p>
                    <p class="text-muted-foreground text-sm">
                        étudiant·e·s détenu·e·s suivi·e·s
                    </p>
                </div>
                <div>
                    <p class="text-btp-blue text-4xl font-extrabold">2</p>
                    <p class="text-muted-foreground text-sm">
                        centres pénitentiaires, à Rennes et Vezin-le-Coquet
                    </p>
                </div>
            </div>
            <p class="text-center">
                <a
                    href="/projets/bouge-ta-prison/tutorat"
                    class={cn(
                        buttonVariants({ variant: "outline" }),
                        "border-btp-blue text-btp-blue hover:text-btp-blue"
                    )}
                >
                    Tout savoir sur le tutorat
                </a>
            </p>
        </section>

        <section class="w-full max-w-3xl text-center">
            <h2 class="mb-8 text-center text-2xl font-bold">Dans la presse</h2>
            <blockquote class="mb-3">
                <p class="font-title text-2xl">
                    «&nbsp;Si je peux aider un peu pour leur réinsertion, tant
                    mieux&nbsp;»
                </p>
            </blockquote>
            <p class="text-muted-foreground mb-8 text-sm">
                Une étudiante tutrice, dans un reportage de France 3
            </p>
            <p>
                À lire&nbsp;: le{" "}
                <a
                    href="https://france3-regions.francetvinfo.fr/bretagne/ille-et-vilaine/rennes/temoignage-si-je-peux-aider-un-peu-pour-leur-reinsertion-tant-mieux-pourquoi-cette-etudiante-accompagne-les-detenus-qui-reprennent-leurs-etudes-2912339.html"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link"
                >
                    témoignage sur France 3 Régions
                </a>
                {" "}et l'<a
                    href="https://www.campusmatin.com/vie-campus/experience-etudiante/une-supbox-pour-repenser-l-acces-a-l-enseignement-superieur-en-prison.html"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link"
                    >article de Campus Matin</a
                >. Le projet est aussi apparu dans Ouest France et des journaux
                locaux.
            </p>
        </section>
    </div>
</Public>
