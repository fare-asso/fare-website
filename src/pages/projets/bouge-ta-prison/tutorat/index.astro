---
import { CheckIcon } from "lucide-react"

import TutorApplicationForm from "@/components/public/bougeTaPrison/tutorApplicationForm"
import { buttonVariants } from "@/components/ui/button"
import Public from "@/layouts/Public.astro"
import { cn } from "@/lib/utils"

export const prerender = true
---

<Public title="Devenir tuteur Bouge ta Prison">
    <div class="flex w-full flex-col items-center justify-start">
        <div
            class="mb-16 flex w-full max-w-3xl flex-col items-center text-center"
        >
            <a
                href="/projets/bouge-ta-prison"
                class="text-btp-blue mb-3 text-sm font-semibold tracking-widest uppercase hover:underline"
            >
                Bouge Ta Prison
            </a>
            <h1 class="mb-4 text-3xl font-extrabold sm:text-4xl">
                Devenir tuteur·ice en détention
            </h1>
            <p class="mb-8 text-lg">
                La FARE propose du tutorat méthodologique et disciplinaire aux
                étudiant·e·s sous main de justice qui commencent ou reprennent
                des études universitaires, à la prison des femmes de Rennes et à
                celle des hommes de Vezin-le-Coquet.
            </p>
            <a
                href="#candidature"
                class={cn(
                    buttonVariants({ size: "lg" }),
                    "bg-btp-blue hover:bg-btp-blue/90 text-white"
                )}
            >
                Candidater
            </a>
            <p class="text-muted-foreground mt-4 text-sm">
                Vous avez jusqu'au <strong>30 mai</strong> pour postuler
            </p>
        </div>

        <section class="mb-16 w-full max-w-4xl">
            <h2 class="mb-8 text-center text-2xl font-bold">
                Comment ça se passe ?
            </h2>
            <ol class="grid grid-cols-1 gap-8 md:grid-cols-3">
                <li class="flex flex-col items-center text-center">
                    <span
                        class="bg-btp-blue mb-3 flex h-10 w-10 items-center justify-center rounded-full text-lg font-bold text-white"
                    >
                        1
                    </span>
                    <h3 class="mb-2 font-semibold">
                        Candidatez avant le 30 mai
                    </h3>
                    <p class="text-muted-foreground text-sm">
                        Avec le formulaire ci-dessous. CV et lettre de
                        motivation obligatoires.
                    </p>
                </li>
                <li class="flex flex-col items-center text-center">
                    <span
                        class="bg-btp-blue mb-3 flex h-10 w-10 items-center justify-center rounded-full text-lg font-bold text-white"
                    >
                        2
                    </span>
                    <h3 class="mb-2 font-semibold">Formez-vous en septembre</h3>
                    <p class="text-muted-foreground text-sm">
                        Une formation de quelques heures précède le début du
                        tutorat.
                    </p>
                </li>
                <li class="flex flex-col items-center text-center">
                    <span
                        class="bg-btp-blue mb-3 flex h-10 w-10 items-center justify-center rounded-full text-lg font-bold text-white"
                    >
                        3
                    </span>
                    <h3 class="mb-2 font-semibold">
                        Accompagnez toute l'année
                    </h3>
                    <p class="text-muted-foreground text-sm">
                        En binôme, 1h30 toutes les deux semaines hors vacances
                        scolaires. Au moins un·e des deux tuteur·rice·s est de
                        la même filière que l'étudiant·e.
                    </p>
                </li>
            </ol>
        </section>

        <aside class="border-btp-gold mb-16 w-full max-w-2xl border-l-4 pl-4">
            <p class="text-muted-foreground text-sm">
                Bon à savoir&nbsp;: les contraintes d'emploi du temps sont
                justifiées par une dispense d'assiduité, et l'engagement peut
                être valorisé à l'<strong>Université Rennes 2</strong>{" "}dans
                le cadre de la Validation de l'Engagement Étudiant (VEE).
            </p>
        </aside>

        <section
            id="candidature"
            class="mb-16 w-full max-w-3xl scroll-mt-24 text-center"
        >
            <h2 class="mb-6 text-center text-2xl font-bold">Candidature</h2>
            <p class="mb-4">Pour candidater, les prérequis sont&nbsp;:</p>
            <ul class="mb-8 inline-flex flex-col items-start gap-2 text-left">
                <li class="flex items-center gap-2">
                    <CheckIcon className="text-btp-blue shrink-0" size={20} />
                    <span>
                        être <strong>minimum en L3</strong> sur l'année{" "}
                        <strong>2026-2027</strong>
                    </span>
                </li>
                <li class="flex items-center gap-2">
                    <CheckIcon className="text-btp-blue shrink-0" size={20} />
                    <span>être <strong>étudiant·e à Rennes</strong></span>
                </li>
                <li class="flex items-center gap-2">
                    <CheckIcon className="text-btp-blue shrink-0" size={20} />
                    <span>
                        disposer d'un <strong>casier judiciaire vierge</strong>
                    </span>
                </li>
            </ul>
            <p class="text-muted-foreground mb-8 text-sm">
                Lieu ou année d'études encore incertains (candidature en master,
                redoublement)&nbsp;? Vous pouvez tout de même candidater&nbsp;:
                vous confirmerez votre engagement au moment des résultats. Les
                étudiant·e·s en année de césure ne sont pas accepté·e·s.
            </p>
            <p class="mb-3">
                Vous vous demandez si vous êtes éligible, ou vous voulez en
                savoir plus sur la candidature&nbsp;?
            </p>
            <a
                href="/projets/bouge-ta-prison/tutorat/question"
                class={cn(
                    buttonVariants({ variant: "outline" }),
                    "border-btp-blue text-btp-blue hover:text-btp-blue"
                )}
            >
                J'ai une question
            </a>
        </section>

        <section class="flex w-full max-w-3xl justify-center">
            <TutorApplicationForm client:load />
        </section>
    </div>
</Public>
