---
import { Image } from "astro:assets"

import logoBagadAsso from "@/assets/Logo_Bagadasso.png"
import FormIsland from "@/components/public/bagadAsso/formIsland.astro"
import { buttonVariants } from "@/components/ui/button"
import Public from "@/layouts/Public.astro"

export const prerender = true
---

<Public title="Badag'Asso">
    <div class="flex w-full flex-col items-center justify-start">
        <Image
            src={logoBagadAsso}
            alt="Logo du projet Bagad'Asso"
            class="mb-12 w-72"
        />

        <div
            class="mb-16 flex w-full max-w-3xl flex-col items-center text-center"
        >
            <h1 class="mb-4 text-3xl font-extrabold sm:text-4xl">
                Du matériel{" "}
                <span class="highlight"> gratuit </span>{" "}
                pour vos évènements !
            </h1>
            <p class="mb-3 text-lg">
                La FARE met à disposition <strong>gratuitement</strong> des
                associations étudiantes du territoire, du matériel
                d'évènementiel et de prévention pour la réalisation de leurs
                évènements.
            </p>
            <p class="text-muted-foreground mb-8 text-sm italic">
                Mais ça veut dire quoi "Bagad'Asso" ? Un Bagad, c'est un
                orchestre traditionnel breton : ici, on remplace les musiciens
                par des associatifs et le public par nos étudiant.e.s
                breton.ne.s !
            </p>
            <a href="#demande" class={buttonVariants({ size: "lg" })}>
                Réserver du matériel
            </a>
            <p class="text-muted-foreground mt-4 text-sm">
                Un matériel manque au catalogue ?{" "}
                <a href="/projets/bagad-asso/suggestion" class="link">
                    Suggérez-le
                </a>
            </p>
        </div>

        <section class="mb-16 w-full max-w-4xl">
            <h2 class="mb-6 text-center text-2xl font-bold">
                Comment ça marche ?
            </h2>
            <ol class="grid grid-cols-1 gap-6 md:grid-cols-3">
                <li
                    class="border-bagad-wood/25 bg-fare-cream/40 flex flex-col items-center rounded-2xl border-2 p-6 text-center"
                >
                    <span
                        class="bg-bagad-wood text-fare-cream mb-3 flex h-10 w-10 items-center justify-center rounded-full text-lg font-bold"
                    >
                        1
                    </span>
                    <h3 class="mb-2 font-semibold">
                        Choisissez votre matériel
                    </h3>
                    <p class="text-muted-foreground text-sm">
                        Parcourez le catalogue ci-dessous&nbsp;: sono, lumières,
                        matériel de prévention et bien plus.
                    </p>
                </li>
                <li
                    class="border-fare-blue/25 bg-fare-blue/5 flex flex-col items-center rounded-2xl border-2 p-6 text-center"
                >
                    <span
                        class="bg-fare-blue mb-3 flex h-10 w-10 items-center justify-center rounded-full text-lg font-bold text-white"
                    >
                        2
                    </span>
                    <h3 class="mb-2 font-semibold">Envoyez votre demande</h3>
                    <p class="text-muted-foreground text-sm">
                        Remplissez le formulaire avec les informations de votre
                        évènement&nbsp;: WEC, gala, soirée…
                    </p>
                </li>
                <li
                    class="border-fare-yellow/40 bg-fare-yellow/5 flex flex-col items-center rounded-2xl border-2 p-6 text-center"
                >
                    <span
                        class="bg-fare-yellow mb-3 flex h-10 w-10 items-center justify-center rounded-full text-lg font-bold text-neutral-900"
                    >
                        3
                    </span>
                    <h3 class="mb-2 font-semibold">Récupérez-le</h3>
                    <p class="text-muted-foreground text-sm">
                        On vérifie la disponibilité, on ne vous demande qu'une
                        caution, et c'est à vous pour l'évènement !
                    </p>
                </li>
            </ol>

            <p class="text-muted-foreground mt-10 mb-4 text-center">
                Et en plus du matériel&nbsp;:
            </p>
            <ul class="flex flex-wrap items-center justify-center gap-3">
                <li class="rounded-full border-2 px-4 py-2 text-sm font-medium">
                    Des personnes de confiance
                </li>
                <li class="rounded-full border-2 px-4 py-2 text-sm font-medium">
                    Tarif réduit sur la SACEM
                </li>
                <li class="rounded-full border-2 px-4 py-2 text-sm font-medium">
                    Tarifs réduits sur les goodies
                </li>
            </ul>
        </section>

        <section id="demande" class="flex w-full scroll-mt-24 justify-center">
            <FormIsland server:defer>
                <p
                    slot="fallback"
                    class="text-muted-foreground w-full max-w-4xl py-12 text-center"
                >
                    Chargement du formulaire…
                </p>
            </FormIsland>
        </section>
    </div>
</Public>
