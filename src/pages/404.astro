---
import { Image } from "astro:assets"

import fareLoutreSad from "@/assets/fare_loutre_sad.jpeg"
import Public from "@/layouts/Public.astro"

import "@/styles/not-found.css"

// rendue à la demande : Astro interdit Astro.rewrite("/404") depuis une
// route SSR vers une page prérendue (ForbiddenRewrite)
---

<Public title="Page introuvable">
    <div class="flex w-full flex-1 flex-col items-center justify-center gap-12">
        <div class="pb-32 pl-16">
            <h2
                class="title-404 m-0 max-w-[14rem] text-3xl text-balance md:max-w-none md:text-4xl"
            >
                Vous vous êtes perdu·e...?
            </h2>
            <Image
                src={fareLoutreSad}
                width={312}
                height={312}
                alt="404"
                class="sad-otter size-40"
            />
        </div>
        <a href="/" class="text-lg underline">Retour à l'accueil</a>
    </div>
</Public>
