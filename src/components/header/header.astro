---
import { Image } from "astro:assets"

import logo from "@/assets/logo_fare.png"

import HeaderLinks from "./headerLinks.astro"

import "./header.css"
---

<header class="v1f">
    <a href="/" class="v1f-logo" aria-label="Accueil">
        <Image
            src={logo}
            alt="FARE de Haute-Bretagne"
            loading="eager"
            width={150}
        />
    </a>
    <HeaderLinks />
</header>
