---
import { Image } from "astro:assets"
import { MessageCircleQuestionMarkIcon } from "lucide-react"

import logo from "@/assets/logo_fare.png"

import HeaderLinks from "./headerLinks.astro"

import "./header.css"
---

<header class="v1f">
    <a href="/" class="v1f-logo">
        <Image
            src={logo}
            alt="FARE de Haute-Bretagne — Accueil"
            priority
            width={82}
            densities={[1, 2]}
        />
    </a>
    <a href="/assistance" class="v1f-cta">
        <span class="v1f-cta-pill">
            <MessageCircleQuestionMarkIcon
                className="v1f-cta-icon"
                aria-hidden="true"
            />
            <span>Contactez vos élus·es étudiants·es</span>
        </span>
    </a>
    <HeaderLinks />
</header>
