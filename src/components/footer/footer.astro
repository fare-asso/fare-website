---
import { Compass, ShieldUser } from "lucide-react"
import { FaFacebook, FaInstagram } from "react-icons/fa6"
import WebsiteCarbonBadge from "../public/websiteCarbonBadge.astro"

const year = new Date().getFullYear()

const columns = [
    {
        title: "La fédération",
        links: [
            { label: "À propos", href: "/a-propos" },
            { label: "Le Bureau", href: "/a-propos/bureau" },
            { label: "Le réseau", href: "/a-propos/reseau" },
            { label: "Nous contacter", href: "/a-propos/contact" }
        ]
    },
    {
        title: "Nos projets",
        links: [
            { label: "AGORAé", href: "/projets/agorae" },
            { label: "Bouge Ta Prison", href: "/projets/bouge-ta-prison" },
            { label: "Bagad'Asso", href: "/projets/bagad-asso" }
        ]
    },
    {
        title: "Ressources",
        links: [
            { label: "Représentation", href: "/representation" },
            { label: "Presse", href: "/presse" },
            { label: "Rejoindre la FARE", href: "/a-propos/adhesion" },
            { label: "Assistance", href: "/assistance" }
        ]
    }
]

const socials = [
    {
        label: "Instagram",
        href: "https://www.instagram.com/fare_hautebretagne",
        Icon: FaInstagram
    },
    {
        label: "Facebook",
        href: "https://www.facebook.com/fare.hautebretagne/?locale=fr_FR",
        Icon: FaFacebook
    },
    { label: "Tous nos liens", href: "/liens", Icon: Compass }
]
---

<footer class="mt-auto w-full bg-black text-white">
    <div class="mx-auto w-full max-w-7xl px-6 py-8 sm:py-12">
        <div
            class="flex flex-col gap-8 lg:flex-row lg:justify-between lg:gap-16"
        >
            <div class="flex flex-col gap-4 lg:max-w-xs">
                <p class="text-lg font-semibold">FARE</p>
                <p class="max-w-xs text-sm text-white/70">
                    Fédération des Associations du Réseau Étudiant de
                    Haute-Bretagne.
                </p>
                <div class="mt-2 flex items-center gap-4">
                    {socials.map(({ label, href, Icon }) => (
                            <a
                                href={href}
                                title={label}
                                aria-label={label}
                                class="text-white/80 transition-colors hover:text-white"
                            >
                                <Icon size={22} aria-hidden="true" />
                            </a>
                        ))}
                </div>
            </div>
            <div
                class="grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-3 lg:flex lg:gap-16"
            >
                {columns.map((col) => (
                    <nav class="flex flex-col gap-3" aria-label={col.title}>
                        <h2 class="text-xs font-semibold tracking-wide text-white/50 uppercase">
                            {col.title}
                        </h2>
                        <div class="flex flex-col gap-2 text-sm">
                            {col.links.map((link) => (
                                <a
                                    href={link.href}
                                    class="text-white/80 transition-colors hover:text-white hover:underline"
                                >
                                    {link.label}
                                </a>
                            ))}
                        </div>
                    </nav>
                ))}
            </div>
        </div>
        <div
            class="mt-8 flex flex-col gap-4 border-t border-white/15 pt-6 text-xs text-white/60 sm:flex-row sm:items-center sm:justify-between"
        >
            <p class="flex items-center gap-4">
                © {year} FARE. Tous droits réservés.
                <WebsiteCarbonBadge server:defer />
            </p>
            <nav
                aria-label="Liens légaux"
                class="flex flex-wrap items-center gap-x-5 gap-y-2"
            >
                <a
                    href="/mentions-legales"
                    class="transition-colors hover:text-white hover:underline"
                >
                    Mentions légales
                </a>
                <a
                    href="/politique-de-confidentialite"
                    class="transition-colors hover:text-white hover:underline"
                >
                    Politique de confidentialité
                </a>
                <a
                    href="/login"
                    class="inline-flex items-center gap-1 transition-colors hover:text-white hover:underline"
                >
                    <ShieldUser size={14} aria-hidden="true" />
                    Espace admin
                </a>
            </nav>
        </div>
    </div>
</footer>
