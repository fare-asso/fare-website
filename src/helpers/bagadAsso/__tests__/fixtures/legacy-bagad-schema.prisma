// Minimal pre-normalization schema used only in the disposable PostgreSQL rehearsal.
datasource db {
  provider = "postgresql"
}

model BagadAssoEquipment {
  id        Int     @id @default(autoincrement())
  name      String
  imagePath String?
  deposit   Float   @default(0)
  quantity  Int     @default(1)
}

model BagadAssoTicket {
  id                    Int       @id @default(autoincrement())
  association           String
  firstName             String
  lastName              String
  position              String    @default("")
  phoneNumber           String?
  eventName             String
  eventType             String
  eventDate             DateTime
  eventEndDate          DateTime?
  eventAddr             String
  estimatedParticipants Int       @default(0)
  creationDate          DateTime  @default(now())
  equipments            Json
  associationEmail      String
  representativeEmail   String
  deleted               DateTime?
  validated             DateTime?
}
