{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "taze.config.ts",
        "prisma/seed.ts",
        "src/**/*.test.{ts,tsx}",
        "emails/**/*.test.tsx"
    ],
    "ignoreExportsUsedInFile": {
        "interface": true,
        "type": true
    },
    "tags": ["-lintignore"],
    "ignoreBinaries": ["only-allow"],
    "ignoreDependencies": ["postcss-load-config"],
    "ignoreIssues": {
        "src/components/ui/**": [
            "exports",
            "types",
            "enumMembers",
            "namespaceMembers"
        ]
    }
}
