{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "taze.config.ts",
        "prisma/seed.ts",
        "src/**/*.test.{ts,tsx}",
        "src/test/**",
        "emails/**/*.test.tsx",
        "src/components/header/defenseDroitsButton.tsx"
    ],
    "ignoreDependencies": ["postcss-load-config"],
    "ignoreIssues": {
