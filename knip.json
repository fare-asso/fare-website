{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "taze.config.ts",
        "prisma/seed.ts",
        "prisma/backfillBagadTicketEquipment.ts",
        "src/**/*.test.{ts,tsx}",
        "src/test/**",
        "emails/**/*.test.tsx"
    ],
    "ignore": ["src/helpers/bagadAsso/__tests__/fixtures/*.prisma"],
    "ignoreDependencies": ["@prisma/client"],
    "ignoreBinaries": ["upm"],
    "ignoreIssues": {
        "src/components/ui/**": [
