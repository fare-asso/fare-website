{
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "esnext"],
        "types": ["vite/client"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "incremental": true,
        "rootDir": ".",
        "paths": {
            "@/*": ["./src/*"],
            "#public/*": ["./public/*"]
        },
        "target": "ES2023"
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules", ".output", ".nitro"]
}
