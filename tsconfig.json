{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "lib": ["dom", "dom.iterable", "esnext"],
        "target": "ES2023",
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "rootDir": ".",
        "paths": {
            "@/*": ["./src/*"],
            "#public/*": ["./public/*"]
        }
    },
    "include": [".astro/types.d.ts", "**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules", "dist"]
}
