generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_POSTGRES_PRISMA_URL")
  directUrl = env("SUPABASE_POSTGRES_PRISMA_DIRECT_URL")
}

model Permission {
  id          Int               @id @default(autoincrement())
  title       String            @default("Permission")
  name        String            @unique
  category    String            @default("")
  description String?
  users       UserPermission[]
}

model UserPermission {
  id           Int         @id @default(autoincrement())
  user         User        @relation(fields: [userId], references: [id])
  userId       String
  permission   Permission  @relation(fields: [permissionId], references: [id])
  permissionId Int

  @@unique([userId, permissionId])
}

model User {
  id              String       @id @default(uuid())
  name            String?
  email           String
  image           String?
  createdAt       DateTime     @default(now())
  role            Role         @default(MEMBER)
  writtenArticles Article[]
  association     Association?
  createdEvents   Event[]
  validatedArticles Article[] @relation("ValidatedArticles")
  permissions     UserPermission[]
}

model Member {
  id           Int     @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String
  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?
  picturePath  String
  position     String  @default("membre actif")
  order        Int     @default(0)
}

model Association {
  id               Int      @id @default(autoincrement())
  name             String
  major            String
  desc             String
  location         String
  discord          String?
  facebook         String?
  instagram        String?
  logoPath         String
  twitter          String?
  website          String?
  birthdate        DateTime @default(now())
  representativeId String?  @unique
  email            String   @default("")
  officePath       String?
  representative   User?    @relation(fields: [representativeId], references: [id])
}

model Event {
  id         Int      @id @default(autoincrement())
  name       String
  image      String
  desc       String
  createdAt  DateTime @default(now())
  startTime  DateTime
  endTime    DateTime
  location   String
  categoryId Int
  creatorId  String
  visibility Boolean  @default(false)
  category   Category @relation(fields: [categoryId], references: [id])
  createdBy  User     @relation(fields: [creatorId], references: [id])
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  events Event[]
}

model Article {
  id         Int      @id @default(autoincrement())
  title      String
  authorId   String
  writtenOn  DateTime @default(now())
  content    Json
  imagesPath String[]
  published  Boolean  @default(false)
  author     User     @relation(fields: [authorId], references: [id])

  status ArticleStatus @default(DRAFT)
  validatedById String?
  validatedBy User? @relation("ValidatedArticles", fields: [validatedById], references: [id])
  validatedAt DateTime?
}

model CommuniqueDePresse {
  id        Int        @id @default(autoincrement())
  name      String
  filePath  String
  createdAt DateTime   @default(now())
  size      Int        @default(0)
  type      PresseType @default(CDP)
}

model BagadAssoEquipment {
  id        Int     @id @default(autoincrement())
  name      String
  imagePath String?
  deposit   Float   @default(0)
  quantity  Int     @default(1)
}

model BagadAssoTicket {
  id                    Int      @id @default(autoincrement())
  assocation            String
  firstName             String
  lastName              String
  phoneNumber           String?
  eventName             String
  eventType             String
  eventDate             DateTime
  eventAddr             String
  estimatedParticipants Int      @default(0)
  creationDate          DateTime @default(now())
  equipments            Json
  associationEmail      String
  representativeEmail   String
  deleted               DateTime?
}

model Adhesion {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  association    String
  folderPath     String
}

model BTPTutorApplication {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  firstName   String
  lastName    String
  email       String
  major       String
  studyYear   String
  mlPath      String
  cvPath      String
  approved    Boolean   @default(false)
  archived    DateTime?
}

model BTPTutorQuestion {
  id          Int       @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String
  major       String
  studyYear   String
  question    String
  createdAt   DateTime  @default(now())
  read        Boolean   @default(false)
  archived    DateTime?
}

model LocationCache {
  id             Int      @id @default(autoincrement())
  query          String   @unique
  response       Json[]
  lastAccessedAt DateTime @default(now())
}

model BugReport {
  id          Int    @id @default(autoincrement())
  email       String
  type        String @default("autre")
  description String
}

enum Role {
  MEMBER
  ADMIN
  ASSO_OWNER
}

enum PresseType {
  CDP
  DDP
}

enum ArticleStatus {
  DRAFT
  PENDING
  VALIDATED
  REJECTED
}
