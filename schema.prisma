generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  image     String
  createdAt DateTime @default(now())
  createdEvents Event[]
  role Role
  writtenArticles Article[]
}

model Member {
  id        Int      @id @default(autoincrement())
  firstName       String
  lastName        String
  image     String
  email     String   @unique
  facebookUrl   String?
  instagramUrl  String?
  twitterUrl    String?
}

model Association {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  logo      String
  major     String
  desc      String
  location  String
}

model Event {
  id        Int      @id @default(autoincrement())
  name      String
  image     String
  desc      String
  createdAt DateTime @default(now())
  startTime DateTime
  endTime   DateTime
  location  String
  category  Category  @relation(fields: [categoryId], references: [id])
  categoryId  Int
  createdBy User      @relation(fields: [creatorId], references: [id])
  creatorId Int
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String
  events Event[]
}

model Article {
  id  Int     @id @default(autoincrement())
  title String
  content String
  author  User    @relation(fields: [authorId], references: [id])
  authorId  Int
}

enum Role {
  MEMBER
  ADMIN
  ASSO_OWNER
}
