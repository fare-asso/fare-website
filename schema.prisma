generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url = env("SUPABASE_POSTGRES_PRISMA_URL")
  directUrl = env("SUPABASE_POSTGRES_PRISMA_DIRECT_URL")

  // url       = env("POSTGRES_PRISMA_URL")
  // directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id        String      @id @default(uuid())
  name      String?
  image     String?
  createdAt DateTime @default(now())
  createdEvents Event[]
  role Role             @default(MEMBER)
  writtenArticles Article[]
}

model Member {
  id            Int       @id @default(autoincrement())
  firstName     String
  lastName      String
  position      String    @default("membre actif")
  picturePath   String
  email         String
  facebookUrl   String?
  instagramUrl  String?
  twitterUrl    String?
}

model Association {
  id        Int      @id @default(autoincrement())
  name      String
  logoPath  String[]
  major     String
  desc      String
  birthdate DateTime @default(now())
  location  String
  website   String?
  facebook  String?
  instagram String?
  twitter   String?
  discord   String?
}

model Event {
  id        Int      @id @default(autoincrement())
  name      String
  image     String
  desc      String
  createdAt DateTime @default(now())
  startTime DateTime
  endTime   DateTime
  location  String
  category  Category  @relation(fields: [categoryId], references: [id])
  categoryId  Int
  createdBy User      @relation(fields: [creatorId], references: [id])
  creatorId String
  visibility  Boolean @default(false)
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String  @unique
  events Event[]
}

model Article {
  id          Int       @id @default(autoincrement())
  title       String
  content     Json      // content of an article in Delta (Quill Format (subset of JSON))
  imagesPath  String[]
  writtenOn   DateTime  @default(now())
  author      User      @relation(fields: [authorId], references: [id])
  authorId    String
}

model CommuniqueDePresse {
  id          Int       @id @default(autoincrement())
  name        String
  size        Int       @default(0)
  createdAt   DateTime  @default(now())
  filePath    String
}

model LocationCache {
  id              Int       @id @default(autoincrement())
  query           String    @unique
  response        Json[]
  lastAccessedAt  DateTime  @default(now())
}

enum Role {
  MEMBER
  ADMIN
  ASSO_OWNER
}
